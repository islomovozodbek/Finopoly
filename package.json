{
  "name": "finopoly",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @finopoly/server dev\" \"pnpm --filter @finopoly/web dev\"",
